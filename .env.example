# Copy to .env in the repository root (the server loads it on start).

# ---- Users (the only two accounts) -----------------------------------------
# Passwords are hashed with bcrypt on first start and never served to clients.
OWNER_USERNAME=owner
OWNER_PASSWORD=change-me-owner
OWNER_DISPLAY_NAME=Owner
FRIEND_USERNAME=friend
FRIEND_PASSWORD=change-me-friend
FRIEND_DISPLAY_NAME=Friend

# ---- Server ----------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Where the SQLite database and uploaded photos live
DATA_DIR=./server/data
# Set to true when serving over HTTPS (required in production)
SECURE_COOKIES=false
# Set to true when behind nginx/Caddy/Traefik so rate limiting sees real IPs
TRUST_PROXY=false
SESSION_DAYS=30
# Origins allowed to call the API with credentials (Capacitor Android app)
CORS_ORIGINS=https://localhost,http://localhost,capacitor://localhost

# ---- Routing ---------------------------------------------------------------
# brouter (default, free public server with hiking profiles + elevation),
# osrm (public demo server, driving only) or ors (OpenRouteService, needs key)
ROUTING_PROVIDER=brouter
BROUTER_URL=https://brouter.de/brouter
# For your own BRouter instance with UK segments: http://localhost:17777/brouter
#OSRM_URL=https://router.project-osrm.org
#ORS_API_KEY=

# ---- Elevation / search ----------------------------------------------------
# Open Topo Data (EU-DEM 25 m covers the whole UK). Any endpoint with the same
# API works, e.g. a self-hosted instance with OS Terrain 50.
ELEVATION_URL=https://api.opentopodata.org/v1/eudem25m
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Please set a contact so OSM services can reach you if needed
USER_AGENT=TrailsPrivateRoutePlanner/0.1 (you@example.com)

# ---- Optional: Ordnance Survey Maps API (free tier) -------------------------
# Adds an "OS Outdoor" base layer. Get a key at https://osdatahub.os.uk
#OS_DATAHUB_KEY=

APP_NAME=Trails
